{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/favorites.js": {"maxDuration": 30}},
  "headers": [
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/manifest.webmanifest", "headers": [{"key": "Content-Type", "value": "application/manifest+json"}]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]},
    {"source": "/(.*)", "headers": [{"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}
  ]
}
